{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "clock",
        "niri/window"
    ],
    "modules-right": [
    	  "tray",
    	  "pulseaudio#microphone",
        "niri/language",
        "pulseaudio",
        "backlight",
        "battery",
        "custom/power",
      
    ],

    "niri/workspaces": {
        "format": "{index}",
        "disable-scroll": true
    },

    "niri/window": {
        "format": "{title}",
        "icon": false,
        "icon-size": 16,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a, %b %d  %H:%M}",
        "tooltip": false
    },


    "pulseaudio": {
        "format": "vol: {volume}",
        "format-muted": "mute",
        "on-click": "pavucontrol",
        "scroll-step": 2
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "mic on",
        "format-source-muted": "mic of",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "scroll-step": 5
    },
    "backlight": {
        "format": "bri: {percent}",
        "tooltip": false,
        "on-scroll-up": "brightnessctl set 2%+",
        "on-scroll-down": "brightnessctl set 2%-"
    },
    "battery": {
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "bat: {capacity}",
    "format-charging": "bat: {capacity}+",
    "format-plugged": "bat: {capacity}=",
    "tooltip": false
    }
}


